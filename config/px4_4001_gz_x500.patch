diff --git a/ROMFS/px4fmu_common/init.d-posix/airframes/4001_gz_x500 b/ROMFS/px4fmu_common/init.d-posix/airframes/4001_gz_x500
index 2add7a5cb4..bc6152fca1 100644
--- a/ROMFS/px4fmu_common/init.d-posix/airframes/4001_gz_x500
+++ b/ROMFS/px4fmu_common/init.d-posix/airframes/4001_gz_x500
@@ -48,4 +48,43 @@ param set-default SIM_GZ_EC_MAX3 1000
 param set-default SIM_GZ_EC_MAX4 1000
 
 param set-default MPC_THR_HOVER 0.60
-param set-default NAV_DLL_ACT 2
+
+# Swarm failsafe tuning (was set_rc_params.py over MAVLink UDP after boot —
+# unreliable: PX4's mavlink UDP receiver locks onto the FIRST client that
+# talks to it per port and silently drops packets from everyone else
+# afterward. QGC auto-connects and usually wins that race, so the external
+# param_set_send calls were very likely never landing. Baked in here instead
+# so they apply at boot with no dependency on any external MAVLink client.)
+param set COM_RC_IN_MODE 4
+param set NAV_RCL_ACT 0
+param set COM_RCL_EXCEPT 31
+param set GF_ACTION 0
+param set COM_RC_LOSS_T 10
+param set NAV_DLL_ACT 0
+param set COM_LOW_BAT_ACT 0
+param set SIM_BAT_DRAIN 0
+param set COM_OF_LOSS_T 5.0
+
+# Arming health-check relaxation (2026-07-14): under swarm-boot CPU
+# contention, the EKF's GPS position/velocity innovation test ratios
+# transiently spike above the default 5.0 SD gate, tripping
+# pre_flt_fail_innov_pos_horiz/vel_horiz and blocking arming with
+# "Resolve system health failures first" — not a real fault, just a
+# convergence hiccup. Widened gates give the EKF more margin before
+# arming is refused. See EKF2.cpp kMinTestRatioPreflight (hardcoded,
+# not tunable) which compares against these test ratios.
+param set EKF2_GPS_P_GATE 10.0
+param set EKF2_GPS_V_GATE 10.0
+
+echo "[SWARM-PARAMS-CHECK]"
+param show COM_RC_IN_MODE
+param show NAV_RCL_ACT
+param show COM_RCL_EXCEPT
+param show GF_ACTION
+param show COM_RC_LOSS_T
+param show NAV_DLL_ACT
+param show COM_LOW_BAT_ACT
+param show SIM_BAT_DRAIN
+param show COM_OF_LOSS_T
+param show EKF2_GPS_P_GATE
+param show EKF2_GPS_V_GATE
